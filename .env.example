# Server
PORT=4000
NODE_ENV=development

# Postgres — either set DATABASE_URL, or the individual PG* vars below
DATABASE_URL=postgres://basedchat:basedchat@localhost:5432/basedchat
# PGHOST=localhost
# PGPORT=5432
# PGUSER=basedchat
# PGPASSWORD=basedchat
# PGDATABASE=basedchat

# Auth
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

# CORS — only matters if you serve the frontend from somewhere OTHER than
# this backend (e.g. a separate live-server / different port). If you open
# the app at http://localhost:PORT (this server serves the HTML too), it's
# same-origin and CORS doesn't apply. Leave unset (defaults to '*') for easy
# local testing; set to your real frontend URL before deploying.
# CLIENT_ORIGIN=https://your-frontend.com

# Where uploaded files are written on disk (served at /uploads/*)
UPLOAD_DIR=uploads
MAX_VIDEO_MB=200
MAX_IMAGE_MB=10
